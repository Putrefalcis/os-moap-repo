guest/busybox/upstream/.kconfig.d
guest/busybox/upstream/busybox
guest/busybox/upstream/busybox_unstripped*
guest/busybox/upstream/applets/applet_tables
guest/busybox/upstream/include/autoconf.h
guest/busybox/upstream/include/config/
