guest/pkgs/sysroot/
guest/pkgs/*.wasm
guest/pkgs/*.tar.*
# busybox kbuild artifacts (regenerated by guest/build.sh)
guest/busybox/upstream/**/*.o
guest/busybox/upstream/**/*.a
guest/busybox/upstream/**/*.s
guest/busybox/upstream/**/.*.cmd
